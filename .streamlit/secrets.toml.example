# 登录凭据配置示例
# 复制此文件为 secrets.toml 并修改相应的值

[login]
username = "your_username_here"
password = "your_password_here"

# OpenAI API密钥（可选，也可以通过界面输入）
# openai_api_key = "your-openai-api-key-here"

# 初始化命令配置（可选）
# 这些命令将在应用启动时执行一次
# 支持使用 && 连接多个命令
# INIT_CMD1: 主初始化命令，如果失败或为空则执行 INIT_CMD2
# INIT_CMD2: 备用初始化命令，当 INIT_CMD1 失败或为空时执行
# 命令执行超时时间为 5 分钟

[init]
# 示例：创建目录并下载配置文件
# Linux/Mac: INIT_CMD1 = "mkdir -p /tmp/app_data && curl -o /tmp/app_data/config.json https://example.com/config.json && echo 'Init completed'"
# Windows: INIT_CMD1 = "mkdir C:\\temp\\app_data & curl -o C:\\temp\\app_data\\config.json https://example.com/config.json & echo Init completed"

# 示例：备用命令，使用本地默认配置
# Linux/Mac: INIT_CMD2 = "mkdir -p /tmp/app_data && cp ./default_config.json /tmp/app_data/config.json && echo 'Fallback init completed'"
# Windows: INIT_CMD2 = "mkdir C:\\temp\\app_data & copy default_config.json C:\\temp\\app_data\\config.json & echo Fallback init completed" 