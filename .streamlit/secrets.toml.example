# 登录凭据配置示例
# 复制此文件为 secrets.toml 并修改相应的值

[login]
username = "your_username_here"
password = "your_password_here"

# OpenAI API密钥（可选，也可以通过界面输入）
# openai_api_key = "your-openai-api-key-here"

# 初始化命令配置（可选）
# 这些命令将在应用启动时执行一次
# 支持多种配置方式：
#   1. 多行脚本字面量（使用 ''' 包裹，支持 # 注释、空行、行末 \ 续行、换行执行独立命令）
#   2. 单行字符串（使用 && 连接多个命令）
#   3. 数组列表（如 ["cmd1", "cmd2"]）
# INIT_CMD1: 主初始化命令，如果执行失败或为空则执行 INIT_CMD2
# INIT_CMD2: 备用初始化命令，当 INIT_CMD1 失败或为空时执行
# 命令执行超时时间为 5 分钟

[init]
# 示例 1（推荐）：清晰的多行脚本格式（使用 ''' 字面量多行字符串包裹）
# - 支持 # 注释与空行
# - 行末使用 \ 则与下一行合并为同一条命令（如结合 && \ 实现前置依赖）
# - 行末不带 \ 则按换行顺序执行独立命令（上一行失败不影响下一行）
# - 若需任何命令失败立即终止并触发 INIT_CMD2，可在首行加上 set -e
INIT_CMD1 = '''
# 1. 基础环境变量
export GH_TOKEN="your_github_token_here"
export PATH="/tmp/bin:$PATH"

# 2. 准备目录
mkdir -p /tmp/bin /tmp/download /tmp/app_bin

# 3. 安装官方 gh 客户端（多行使用 && \ 保证前置成功后才继续）
curl -sSL "https://github.com/cli/cli/releases/download/v2.55.0/gh_2.55.0_linux_amd64.tar.gz" -o /tmp/gh.tar.gz && \
tar -xzf /tmp/gh.tar.gz -C /tmp/bin --strip-components=2 gh_2.55.0_linux_amd64/bin/gh && \
chmod +x /tmp/bin/gh && \
rm -f /tmp/gh.tar.gz

# 4. 下载、解压并部署 Release
gh release download "v1.7.8" --repo "zhyhang/wsstun" --pattern "wsstun-v1.7.8-x86_64-unknown-linux-musl.tar.gz" --dir /tmp/download --clobber && \
tar -xf /tmp/download/wsstun-v1.7.8-x86_64-unknown-linux-musl.tar.gz -C /tmp/app_bin && \
find /tmp/app_bin -type f -name "*wsstun*" ! -name "wsstun" -exec mv {} /tmp/app_bin/wsstun ";" && \
chmod +x /tmp/app_bin/wsstun && \
rm -rf /tmp/download

echo "Init: wsstun deployed successfully"
'''

# 示例 2：备用回退命令
INIT_CMD2 = "echo 'Fallback: Init CMD1 failed or not configured'" 